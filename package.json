{
	"name": "reader",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"build:github-pages": "DEPLOY_TARGET=github-pages vite build",
		"verify:build": "bun run build && bun scripts/verify-static-build.ts / && bun run build:github-pages && bun scripts/verify-static-build.ts /Granthalay/",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"lint": "prettier --check . && eslint . --concurrency auto",
		"format": "prettier --write .",
		"deploy": "gh-pages -d build -f"
	},
	"dependencies": {
		"@readium/navigator": "^2.8.2",
		"@readium/shared": "^2.4.0",
