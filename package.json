		"lucide-svelte": "^1.0.1",
		"pino": "^10.3.1",
		"sanitize-html": "^2.17.7",
		"xmldom": "^0.6.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.59.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
